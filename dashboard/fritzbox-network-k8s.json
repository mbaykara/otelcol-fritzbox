{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "fritzbox-network"
  },
  "spec": {
    "title": "Fritz!Box Network Overview",
    "description": "Fritz!Box metrics via the fritzbox OpenTelemetry receiver (TR-064). Source: https://github.com/mbaykara/fritzotel-receiver",
    "tags": [
      "fritzbox",
      "tr064",
      "opentelemetry"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "WAN Link",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "hw_network_up_ratio{hw_id=\"fritzbox.wan\"}",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 2,
        "title": "Device Uptime",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_device_uptime_seconds",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 3,
        "title": "Hosts (total)",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_hosts_total",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 4,
        "title": "Hosts (active)",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_hosts_active",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 5,
        "title": "WAN Throughput",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(hw_network_io_bytes_total{hw_name=\"wan\"}[5m]) * 8",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "bps"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 6,
        "title": "WAN Link Speed",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "hw_network_bandwidth_limit_bytes_per_second * 8",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "bps"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 7,
        "title": "DSL Sync Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_dsl_rate_current_bit_per_second",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "bps"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 8,
        "title": "DSL Max Rate",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_dsl_rate_max_bit_per_second",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "bps"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 8,
          "y": 12,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 9,
        "title": "DSL Noise Margin / Attenuation",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_dsl_noise_margin_dB",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "snr {{network_io_direction}}"
          },
          {
            "refId": "B",
            "expr": "fritzbox_dsl_attenuation_dB",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "attn {{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "dB"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 16,
          "y": 12,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 10,
        "title": "WLAN Clients",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_wlan_clients",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{hw_id}} {{ssid}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            }
          },
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 11,
        "title": "WLAN Channel",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "fritzbox_wlan_channel_ratio",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{hw_id}} {{ssid}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            }
          },
          "overrides": []
        },
        "gridPos": {
          "x": 8,
          "y": 20,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 12,
        "title": "WLAN Packets",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(hw_network_packets_total{hw_id=~\"fritzbox.wlan.*\"}[5m])",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{hw_id}} {{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            },
            "unit": "pps"
          },
          "overrides": []
        },
        "gridPos": {
          "x": 16,
          "y": 20,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 13,
        "title": "DSL Errors",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(hw_errors_total[5m])",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{error_type}} {{network_io_direction}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            }
          },
          "overrides": []
        },
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 14,
        "title": "DSL Errored Seconds",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(fritzbox_dsl_error_seconds_total[5m])",
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "legendFormat": "{{severity}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 15
            }
          },
          "overrides": []
        },
        "gridPos": {
          "x": 12,
          "y": 28,
          "w": 12,
          "h": 8
        }
      }
    ]
  }
}