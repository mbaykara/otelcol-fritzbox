{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "fritzbox": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https?://[^/]+"},
        "collectionInterval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
      }
    },
    "otlp": {
      "type": "object",
      "properties": {
        "endpoint": {"type": "string", "pattern": "^(|https?://.+)$"},
        "auth": {"enum": ["basic", "none"]}
      }
    },
    "memoryLimiter": {
      "type": "object",
      "properties": {
        "limitPercentage": {"type": "integer", "minimum": 1, "maximum": 100},
        "spikeLimitPercentage": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
